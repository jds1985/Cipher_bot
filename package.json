{
  "name": "cipher",
  "productName": "Cipher",
  "version": "0.1.0",
  "description": "Cipher bots: a local-first desktop app. Your Cipher bots run on your own computer; nothing leaves it.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "jds1985",
    "email": "197778109+jds1985@users.noreply.github.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && cross-env ELECTRON_RUN_AS_NODE=1 electron --test \"dist/test/**/*.test.js\"",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.jds1985.cipher",
    "productName": "Cipher",
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
