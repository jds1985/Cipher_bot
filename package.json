{
  "name": "cipher",
  "productName": "Cipher",
  "version": "1.25.0",
  "description": "Cipher bots: a local-first desktop app. Your Cipher bots run on the Cipher model (Jim's own), bundled and running on your computer. Web search only when Online is on and you press Search.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "jds1985",
    "email": "197778109+jds1985@users.noreply.github.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && cross-env ELECTRON_RUN_AS_NODE=1 electron --test \"dist/test/**/*.test.js\"",
    "postinstall": "node scripts/rebuild-native.mjs",
    "dist": "npm run native && npm run model && npm run build && electron-builder",
    "dist:dir": "npm run native && npm run model && npm run build && electron-builder --dir",
    "native": "make -C native/cipher-serve",
    "model": "node scripts/fetch-model.mjs"
  },
  "build": {
    "appId": "com.jds1985.cipher",
    "productName": "Cipher",
    "files": [
      "dist/**/*",
      "dist/phone/**/*",
      "!dist/test/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,cmaps,standard_fonts,wasm,iccs,types}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "synopsis": "Cipher Bot: your Cipher bots, running on your own computer",
      "description": "Cipher Bot is a local-first desktop app. Your Cipher bots run on the Cipher model (Jim's own), bundled and running on your own computer. No account needed.",
      "desktop": {
        "entry": {
          "Name": "Cipher Bot"
        }
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "LICENSES",
        "to": "LICENSES"
      },
      {
        "from": "resources/bin/${os}-${arch}",
        "to": "bin",
        "filter": [
          "cipher-serve",
          "cipher-serve.exe"
        ]
      },
      {
        "from": "resources/model",
        "to": "model",
        "filter": [
          "manifest.json",
          "*.ctern",
          "!*dev*",
          "!*private*"
        ]
      }
    ],
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4"
  }
}
